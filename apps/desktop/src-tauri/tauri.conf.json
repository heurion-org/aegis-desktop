{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegis Desktop",
  "version": "0.1.0",
  "identifier": "ai.aegisos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aegis Desktop",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* wss://*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/aegis-os"
    ],
    "linux": {
      "deb": {
        "depends": ["bubblewrap"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
